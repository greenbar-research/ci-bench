#!/usr/bin/env bash
# Controller for the unscored GitHub Actions pilot.
#
#   bin/ci/pilot-github dispatch PROFILE CACHE_PHASE CACHE_EPOCH EXPECTED_SHA [RUNNER]
#   bin/ci/pilot-github collect RUN_ID [EVIDENCE_DIR]
#   bin/ci/pilot-github probe EXPECTED_SHA [RUNNER]
#
# RUNNER is the runs-on label (default ubuntu-24.04, GitHub-hosted); runner
# provider labels select those targets through the same workflows.
#
# dispatch (pilot.yml) and probe (probe.yml) record controller clock
# request/acceptance times and the run ID returned by the workflow dispatch
# API, poll to the controller's terminal observation, then collect. collect records provider IDs and
# boundaries, the in-job artifact, sanitized logs, and a provenance record.
# Evidence stays local under tmp/pilot-evidence (gitignored) unless copied.
set -euo pipefail

cd "$(dirname "$0")/../.."
repo="${CI_BENCH_REPO:-greenbar-research/ci-bench}"
iso_now() { date -u +%Y-%m-%dT%H:%M:%S.%3NZ; }

# throttle NAME MIN_MS: spaces every HTTP attempt to one API, including
# retries, across all controllers on this host (lock and timestamp under
# TMPDIR), bounding the aggregate rate. When CI_BENCH_LIMITER_LOG is set, each
# call appends the milliseconds it waited, so records can separate client-side
# delay from provider time.
throttle() {
  local file="${TMPDIR:-/tmp}/ci-bench-$1.rate" min_ms="$2" fd last now waited=0
  exec {fd}>>"$file.lock"
  flock "$fd"
  last="$(cat "$file" 2>/dev/null || echo 0)"
  now="$(date +%s%3N)"
  if (( now - last < min_ms )); then
    waited=$((min_ms - now + last))
    sleep "$(awk -v ms="$waited" 'BEGIN { print ms / 1000 }')"
  fi
  date +%s%3N > "$file"
  exec {fd}>&-
  if [[ -n "${CI_BENCH_LIMITER_LOG:-}" ]]; then echo "$waited" >> "$CI_BENCH_LIMITER_LOG"; fi
}

# limiter_summary FILE: total wait and attempt count logged by throttle.
limiter_summary() {
  awk '{ total += $1; n++ } END { printf "{\"wait_ms\": %d, \"attempts\": %d}", total, n }' "$1" 2>/dev/null || echo '{"wait_ms": 0, "attempts": 0}'
}

# GitHub allows 5,000 REST requests per hour; 800 ms spacing keeps all
# controllers together under 4,500.
ghapi() { throttle github 800; gh api "$@"; }

# Revision of the controller code that started this run, captured once at
# controller start before any request. A running Bash controller keeps the
# definitions it started with, so this can differ from both the measured SHA
# and a later collector.
controller_revision() {
  jq -n --arg sha "$(git rev-parse HEAD)" --argjson dirty "$([[ -z "$(git status --porcelain -- bin/ci)" ]] && echo false || echo true)" \
    '{sha: $sha, bin_ci_dirty: $dirty}'
}

# verify_pilot_tag SHA: the measured commit is dispatched through the
# immutable lightweight tag pilot/SHA, so later collector-only pushes to main
# never change what a run or a cold/warm pair measures.
verify_pilot_tag() {
  local sha="$1" object
  object="$(ghapi "repos/$repo/git/ref/tags/pilot/$sha" --jq '"\(.object.type) \(.object.sha)"' 2>/dev/null || true)"
  if [[ "$object" != "commit $sha" ]]; then
    echo "tag pilot/$sha does not name commit $sha; refusing" >&2
    exit 1
  fi
}

dispatch() {
  local profile="$1" phase="$2" epoch="$3" sha="$4" runner="${5:-ubuntu-24.04}"
  run_workflow pilot.yml "$sha" "$profile" \
    "$(jq -n --arg profile "$profile" --arg phase "$phase" --arg epoch "$epoch" --arg sha "$sha" --arg runner "$runner" \
      '{profile: $profile, cache_phase: $phase, cache_epoch: $epoch, expected_sha: $sha, runner: $runner}')"
}

probe() {
  local sha="$1" runner="${2:-ubuntu-24.04}"
  run_workflow probe.yml "$sha" probe "$(jq -n --arg sha "$sha" --arg runner "$runner" '{expected_sha: $sha, runner: $runner}')"
}

# run_workflow WORKFLOW SHA PROFILE INPUTS_JSON: dispatches, polls every 5 s to
# the controller's first terminal observation on the orb clock, then collects.
run_workflow() {
  local workflow="$1" sha="$2" profile="$3" inputs="$4" poll_interval_ms=5000
  local call_started_at revision scratch
  call_started_at="$(iso_now)"
  revision="$(controller_revision)"
  scratch="$(mktemp -d)"
  verify_pilot_tag "$sha"
  local body requested_at first_send_at response accepted_at run_id dir status last_pending_at observed_at polls=0 target
  case "$(jq -r .runner <<<"$inputs")" in
    ubuntu-24.04) target=github-actions ;;
    blacksmith-*) target=blacksmith ;;
    depot-*) target=depot ;;
    namespace-*|nscloud-*) target=namespace ;;
    *) echo "unsupported runner label" >&2; exit 2 ;;
  esac
  body="$(jq -n --arg ref "pilot/$sha" --argjson inputs "$inputs" '{ref: $ref, return_run_details: true, inputs: $inputs}')"
  # requested_at precedes the limiter wait; first_send_at follows it.
  requested_at="$(iso_now)"
  throttle github 800
  first_send_at="$(iso_now)"
  response="$(gh api --method POST "repos/$repo/actions/workflows/$workflow/dispatches" --input - <<<"$body")"
  accepted_at="$(iso_now)"
  run_id="$(jq -r .workflow_run_id <<<"$response")"
  dir="tmp/pilot-evidence/$run_id"
  mkdir -p "$dir"
  jq -n --arg call_started_at "$call_started_at" --arg first_send_at "$first_send_at" \
    --arg requested_at "$requested_at" --arg accepted_at "$accepted_at" --arg workflow "$workflow" \
    --arg profile "$profile" --arg target "$target" --argjson inputs "$inputs" --argjson response "$response" \
    --argjson controller_revision "$revision" --argjson poll_interval_ms "$poll_interval_ms" \
    '{controller_clock: "orb UTC", controller_revision: $controller_revision, poll_interval_ms: $poll_interval_ms,
      dispatch_ref: ("pilot/" + $inputs.expected_sha), target: $target, workflow: $workflow, profile: $profile,
      controller_call_started_at: $call_started_at, trigger_requested_at: $requested_at,
      trigger_first_http_send_at: $first_send_at, trigger_accepted_at: $accepted_at,
      inputs: $inputs, dispatch_response: $response}' > "$dir/controller.json"
  jq -r '"\(.workflow_run_id) \(.html_url)"' <<<"$response"
  # The terminal state became visible between last_nonterminal_response_at
  # and observed_at, both on the orb clock.
  last_pending_at="$accepted_at"
  export CI_BENCH_LIMITER_LOG="$scratch/poll-limiter.log"
  while :; do
    polls=$((polls + 1))
    status="$(ghapi "repos/$repo/actions/runs/$run_id" --jq .status || echo poll-error)"
    if [[ "$status" == completed ]]; then
      observed_at="$(iso_now)"
      break
    fi
    last_pending_at="$(iso_now)"
    sleep "$((poll_interval_ms / 1000))"
  done
  unset CI_BENCH_LIMITER_LOG
  jq --arg observed_at "$observed_at" --arg last_pending_at "$last_pending_at" \
    --argjson poll_interval_ms "$poll_interval_ms" --argjson polls "$polls" --argjson limiter "$(limiter_summary "$scratch/poll-limiter.log")" \
    '.terminal_observation = {observed_at: $observed_at, last_nonterminal_response_at: $last_pending_at,
      poll_interval_ms: $poll_interval_ms, polls: $polls, poll_limiter: $limiter}' "$dir/controller.json" > "$dir/controller.json.new"
  mv "$dir/controller.json.new" "$dir/controller.json"
  rm -rf "$scratch"
  collect "$run_id" "$dir"
}

sanitize() {
  # GitHub masks registered secrets; also strip bearer/basic tokens and
  # GitHub token formats defensively before evidence leaves the runner.
  sed -E \
    -e 's/(gh[pousr]_)[A-Za-z0-9]{20,}/\1[REDACTED]/g' \
    -e 's/(github_pat_)[A-Za-z0-9_]{20,}/\1[REDACTED]/g' \
    -e 's/(AUTHORIZATION: (basic|bearer) )[^ ]+/\1[REDACTED]/Ig'
}

collect() {
  local run_id="$1" dir="${2:-tmp/pilot-evidence/$1}"
  mkdir -p "$dir"
  local observed_at
  observed_at="$(iso_now)"
  ghapi "repos/$repo/actions/runs/$run_id" > "$dir/run.json"
  ghapi "repos/$repo/actions/runs/$run_id/jobs?filter=all" > "$dir/jobs.json"
  ghapi "repos/$repo/actions/runs/$run_id/artifacts" > "$dir/artifacts.json"
  ghapi "repos/$repo/actions/runs/$run_id/logs" > "$dir/logs.zip" 2>/dev/null || rm -f "$dir/logs.zip"
  if [[ -f "$dir/logs.zip" ]]; then
    rm -rf "$dir/logs"
    mkdir -p "$dir/logs"
    unzip -q -o "$dir/logs.zip" -d "$dir/logs.raw"
    (cd "$dir/logs.raw" && find . -type f -print0) | while IFS= read -r -d '' file; do
      mkdir -p "$dir/logs/$(dirname "$file")"
      sanitize < "$dir/logs.raw/$file" > "$dir/logs/$file"
    done
    rm -rf "$dir/logs.raw" "$dir/logs.zip"
  fi
  local artifact_name
  artifact_name="$(jq -r '.artifacts[0].name // empty' "$dir/artifacts.json")"
  if [[ -n "$artifact_name" ]]; then
    rm -rf "$dir/artifact"
    gh run download "$run_id" --repo "$repo" --name "$artifact_name" --dir "$dir/artifact"
    (cd "$dir/artifact" && sha256sum --check --quiet SHA256SUMS) \
      && echo verified > "$dir/artifact-checksums.txt" \
      || echo failed > "$dir/artifact-checksums.txt"
  fi
  ruby bin/ci/pilot-provenance "$dir" "$observed_at" > "$dir/provenance.json"
  jq . "$dir/provenance.json"
}

case "${1:-}" in
  dispatch) shift; dispatch "$@" ;;
  collect) shift; collect "$@" ;;
  probe) shift; probe "$@" ;;
  *) sed -n '2,14p' "$0" >&2; exit 2 ;;
esac
