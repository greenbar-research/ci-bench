#!/usr/bin/env ruby
# Builds the companion provenance record for one pilot sample from evidence
# collected by bin/ci/pilot-github. Uses only the Ruby standard library.
#
#   bin/ci/pilot-provenance EVIDENCE_DIR OBSERVED_AT > provenance.json
require "json"
require "time"

dir, observed_at = ARGV
abort "usage: pilot-provenance EVIDENCE_DIR OBSERVED_AT" unless dir && observed_at

def read_json(path)
  File.exist?(path) ? JSON.parse(File.read(path)) : nil
end

def read_env(path)
  return {} unless File.exist?(path)

  File.readlines(path, chomp: true).filter_map do |line|
    key, value = line.split("=", 2)
    [key, value] if key && value
  end.to_h
end

def ms_between(start, finish)
  return "unknown" unless start && finish

  ((Time.iso8601(finish) - Time.iso8601(start)) * 1000).round
end

controller = read_json(File.join(dir, "controller.json")) || {}
run = read_json(File.join(dir, "run.json")) || {}
jobs = read_json(File.join(dir, "jobs.json"))&.fetch("jobs", []) || []
artifact_dir = File.join(dir, "artifact")
runner = read_env(File.join(artifact_dir, "runner.env"))
cache = read_env(File.join(artifact_dir, "cache.env"))
result = read_json(File.join(artifact_dir, "result.json"))
checksums = File.exist?(File.join(dir, "artifact-checksums.txt")) ? File.read(File.join(dir, "artifact-checksums.txt")).strip : "unavailable"
manifest_profile = controller["profile"] || controller.dig("inputs", "profile")
probe = manifest_profile == "probe"
observation = controller["terminal_observation"] || {}
build = read_json(File.join(dir, "build.json"))
controller_target = controller["target"] || (build ? "buildkite-ghac" : "github-actions")
workflow_file = controller["workflow"] || (probe ? "probe.yml" : "pilot.yml")
# Native Buildkite samples run the pipeline files in .buildkite/ instead of a
# GitHub Actions workflow; their step keys are the logical jobs.
native = controller_target == "buildkite-native"
workflow_path = native ? ".buildkite/#{workflow_file}" : ".github/workflows/#{workflow_file}"
# Toolchain volume the GHAC runtime itself mounts on generated jobs; recorded
# as a provider-owned cache like GitHub's runner image tool cache.
ghac_toolchain_volumes = %w[buildkite-gha-linux-amd64]

# Buildkite builds are normalized into the GitHub run/job fields used below;
# the raw build.json stays in the evidence directory.
if build
  build_jobs = build["jobs"] || []
  workload_jobs = build_jobs.select { |j| j["step_key"].to_s.match?(native ? /\Anative-/ : /\Agha-(?!importer\z|concurrency-)/) }
  bk_job = workload_jobs.first || {}
  retried = build_jobs.any? { |j| j["retried"] || j["retry_source"] || j["retries_count"].to_i.positive? }
  run = {
    "id" => build["number"],
    "status" => build["finished_at"] ? "completed" : build["state"],
    "conclusion" => build["state"] == "passed" ? "success" : build["state"],
    "head_sha" => build["commit"],
    "run_attempt" => retried ? "retried" : 1,
    "created_at" => build["created_at"],
    "run_started_at" => build["started_at"],
    "updated_at" => build["finished_at"],
    "html_url" => build["web_url"],
    "path" => workflow_path,
    "repository" => { "full_name" => "greenbar-research/ci-bench" }
  }
  jobs = [{
    "id" => bk_job["id"],
    "conclusion" => bk_job["state"] == "passed" ? "success" : bk_job["state"],
    "created_at" => bk_job["runnable_at"],
    "started_at" => bk_job["started_at"],
    "completed_at" => bk_job["finished_at"],
    "html_url" => bk_job["web_url"],
    "runner_name" => bk_job.dig("agent", "name"),
    "labels" => bk_job["agent_query_rules"],
    "steps" => []
  }]
  provider_workload_jobs = workload_jobs.map { |j| j["step_key"] }
  provider_orchestration_jobs = (build_jobs - workload_jobs).map { |j| j["step_key"] || j["label"] || j["type"] }
else
  provider_workload_jobs = jobs.map { |j| j["name"] }
  provider_orchestration_jobs = []
end

# Job-graph parity and the comparison group come from the workflow file at the
# expected commit, so samples are compared only within one workflow revision.
repo_root = File.expand_path("../..", __dir__)
expected_sha = controller.dig("inputs", "expected_sha").to_s
workflow_blob = expected_sha.match?(/\A[0-9a-f]{40}\z/) ? `git -C #{repo_root} rev-parse --verify --quiet #{expected_sha}:#{workflow_path} 2>/dev/null`.strip : ""
logical_jobs = begin
  require "yaml"
  definition = YAML.safe_load(`git -C #{repo_root} show #{expected_sha}:#{workflow_path} 2>/dev/null`)
  native ? definition.fetch("steps").map { |step| step.fetch("key") } : definition.fetch("jobs").keys
rescue StandardError
  []
end
graph_parity = !logical_jobs.empty? && provider_workload_jobs.size == logical_jobs.size &&
  (build.nil? || provider_workload_jobs.sort == logical_jobs.map { |key| native ? key : "gha-#{key}" }.sort)

# In-job phase boundaries come from the runner clock (epoch milliseconds).
marks = Hash.new { |hash, key| hash[key] = {} }
phases_path = File.join(artifact_dir, "phases.tsv")
if File.exist?(phases_path)
  File.readlines(phases_path, chomp: true).each do |line|
    at, phase, event = line.split("\t")
    marks[phase][event] ||= Integer(at)
  end
end
phase_names = probe ? %w[checkout identity marker artifact] : %w[checkout cache setup dependencies services workload artifact]
phases = phase_names.to_h do |name|
  start, finish = marks[name].values_at("start", "end")
  [name, start && finish ? { "duration_ms" => finish - start, "started_at_ms" => start, "ended_at_ms" => finish } : "unknown"]
end
phases["artifact"] = { "note" => "upload duration is in provider step timings; in-job mark covers collection only" }.merge(phases["artifact"].is_a?(Hash) ? phases["artifact"] : { "duration_ms" => "unknown" })

job = jobs.first || {}
steps = (job["steps"] || []).map do |step|
  {
    "name" => step["name"],
    "conclusion" => step["conclusion"],
    "started_at" => step["started_at"],
    "completed_at" => step["completed_at"],
    "duration_ms" => ms_between(step["started_at"], step["completed_at"])
  }
end

# The verification oracle comes from the measured commit's manifest, never the
# collector checkout, so reprocessing with a newer collector cannot change it.
expected_digest = nil
measured_manifest = expected_sha.match?(/\A[0-9a-f]{40}\z/) ? `git -C #{repo_root} show #{expected_sha}:benchmark/manifest.yml 2>/dev/null` : ""
if manifest_profile && !probe && !measured_manifest.empty?
  expected_digest = YAML.safe_load(measured_manifest).dig("profiles", manifest_profile, "expected_verification_digest")
end

docker_local = runner["docker_endpoint"].to_s.start_with?("unix://") &&
  %w[docker docker-container].include?(runner["docker_builder"])

issues = []
issues << "provider run status #{run["status"].inspect} is not completed" unless run["status"] == "completed"
issues << "provider run conclusion #{run["conclusion"].inspect} is not success" unless run["conclusion"] == "success"
issues << "provider job conclusion #{job["conclusion"].inspect} is not success" unless job["conclusion"] == "success"
issues << "runner envelope mismatch" unless runner["envelope_match"] == "true"
issues << "runner target #{runner["target"].inspect} does not match #{controller_target}" unless runner["target"] == controller_target
issues << "job graph parity failed (workflow jobs #{logical_jobs.inspect}, provider workload jobs #{provider_workload_jobs.inspect})" unless graph_parity
issues << "source SHA mismatch" unless run["head_sha"] && run["head_sha"] == controller.dig("inputs", "expected_sha") && runner["checkout_sha"] == run["head_sha"]
if probe
  marker_path = File.join(artifact_dir, "marker.txt")
  source_path = File.join(artifact_dir, "source.txt")
  issues << "completion marker missing or not the expected SHA" unless File.exist?(marker_path) && File.read(marker_path).strip == controller.dig("inputs", "expected_sha")
  issues << "source tree dirty" unless File.exist?(source_path) && File.readlines(source_path, chomp: true).drop(1).reject(&:empty?).empty?
else
  issues << "Docker builder is not verified local (endpoint #{runner["docker_endpoint"].inspect}, driver #{runner["docker_builder"].inspect})" unless docker_local
  issues << "cache expectation not met" unless cache["cache_expectation"] == "met"
  issues << "workload result missing or not passed" unless result&.fetch("status", nil) == "passed"
  issues << "expected verification digest unavailable from the measured commit's manifest" unless expected_digest
  issues << "verification digest mismatch" if result && expected_digest && result.dig("verification", "digest") != expected_digest
  issues << "source tree dirty" if result && result["git_dirty"] != false
end
issues << "artifact checksums #{checksums}" unless checksums == "verified"
issues << "run attempt is not 1 or a job was retried" unless run["run_attempt"] == 1

# Provider clock and field names differ by target; the normalized run/job keys
# above map onto these provider fields.
if build
  provider_clock = "Buildkite REST API timestamps (second or sub-second precision)"
  provider_field_mapping = {
    "provider_run_created_at" => "build.created_at", "provider_run_started_at" => "build.started_at",
    "provider_run_updated_at" => "build.finished_at", "provider_job_queued_at" => "workload job runnable_at",
    "provider_job_started_at" => "workload job started_at", "provider_job_completed_at" => "workload job finished_at"
  }
  provider_terminal_boundary = {
    "job_finished_at" => job["completed_at"] || "unknown",
    "build_finished_at" => build["finished_at"] || "unknown",
    "note" => "Buildkite build finished_at is the provider terminal timestamp; #{native ? "native builds have only the pipeline upload step before the workload step" : "it includes the GHAC concurrency finish step after the workload job"}."
  }
else
  provider_clock = "GitHub REST API timestamps (1 s precision)"
  provider_field_mapping = {
    "provider_run_created_at" => "run.created_at", "provider_run_started_at" => "run.run_started_at",
    "provider_run_updated_at" => "run.updated_at", "provider_job_queued_at" => "job.created_at",
    "provider_job_started_at" => "job.started_at", "provider_job_completed_at" => "job.completed_at"
  }
  provider_terminal_boundary = {
    "job_completed_at" => job["completed_at"] || "unknown",
    "completed_run_updated_at" => run["status"] == "completed" ? run["updated_at"] : "unknown",
    "note" => "GitHub exposes no run completed_at; the completed run's updated_at is the latest provider-side terminal timestamp."
  }
end

volumes_before = controller["provider_cache_volumes_before"]
cold_qualification =
  if probe || controller.dig("inputs", "cache_phase") != "cold"
    "not applicable"
  elsif cache["cache_expectation"] != "met"
    "missing: dependency-cache miss not verified"
  elsif controller_target == "github-actions"
    "benchmark-cold: exact dependency-cache miss verified; provider-owned caches unknown"
  elsif volumes_before.nil?
    "missing: cluster cache volumes were not recorded before the build"
  elsif (other = volumes_before.map { |v| v["tag"] || v["name"] || v["id"] }.reject { |n| ghac_toolchain_volumes.include?(n.to_s.split("/").last) }).any?
    "missing: cache volumes present before the build: #{other.join(", ")}"
  else
    toolchain = volumes_before.any? { |v| ghac_toolchain_volumes.include?((v["tag"] || v["name"]).to_s.split("/").last) } ? "present" : "absent"
    "benchmark-cold: exact dependency-cache miss verified; no container-cache or local-builder volumes before the build; GHAC toolchain volume #{toolchain}#{native ? " (not mounted by native steps)" : ""}; other provider-owned caches unknown"
  end

record = {
  "record" => "ci-bench-pilot-provenance/v1",
  "scored" => false,
  "target" => controller_target,
  "runner_target" => runner["target"] || "unknown",
  "repository" => run.dig("repository", "full_name"),
  "workflow_path" => run["path"],
  "source" => {
    "expected_sha" => controller.dig("inputs", "expected_sha"),
    "provider_head_sha" => run["head_sha"],
    "checkout_sha" => runner["checkout_sha"],
    "result_commit_sha" => result&.fetch("commit_sha", nil),
    "result_git_dirty" => result&.fetch("git_dirty", nil),
    "workflow_blob" => workflow_blob.empty? ? "unknown" : workflow_blob
  },
  # Samples are compared only within one group: the full measured commit (which
  # fixes workflow, harness, manifest, and lockfiles), workflow, and profile.
  "comparison_group" => {
    "key" => "#{expected_sha}:#{workflow_path}:#{manifest_profile}",
    "measured_source_sha" => expected_sha,
    "workflow_path" => workflow_path,
    "workflow_blob" => workflow_blob.empty? ? "unknown" : workflow_blob,
    "profile" => manifest_profile,
    "expected_verification_digest" => expected_digest || (probe ? "not applicable" : "unknown")
  },
  # Three revisions stay distinct: the measured source (comparison_group), the
  # controller that started and observed the run, and this collector.
  "controller_revision" => controller["controller_revision"] || "unknown: not recorded at controller start",
  "collector" => {
    "sha" => `git -C #{repo_root} rev-parse HEAD 2>/dev/null`.strip,
    "dirty" => !`git -C #{repo_root} status --porcelain -- bin/ci 2>/dev/null`.strip.empty?
  },
  "graph" => {
    "workflow_logical_jobs" => logical_jobs,
    "provider_workload_jobs" => provider_workload_jobs,
    "provider_orchestration_jobs" => provider_orchestration_jobs,
    "parity" => graph_parity
  },
  "cold_qualification" => cold_qualification,
  "provider_cache_volumes" => { "before" => volumes_before || "not recorded", "after" => controller["provider_cache_volumes_after"] || "not recorded" },
  "inputs" => controller["inputs"],
  "workload_class" => {
    "smoke" => "smoke/setup baseline (installs the full Ruby, Node, ImageMagick, and browser stack and starts services; not pure orchestration overhead)",
    "full" => "full serial Rails workload",
    "probe" => "pure orchestration probe (checkout, runner identity record, completion marker, evidence upload; no dependencies or services)"
  }.fetch(manifest_profile, "unknown"),
  "docker_builder_local" => docker_local,
  "provider" => {
    "run_id" => run["id"],
    "run_attempt" => run["run_attempt"],
    "run_url" => run["html_url"],
    "job_id" => job["id"],
    "job_url" => job["html_url"],
    "status" => run["status"],
    "conclusion" => run["conclusion"],
    "job_conclusion" => job["conclusion"],
    "runner_name" => job["runner_name"],
    "runner_group" => job["runner_group_name"],
    "labels" => job["labels"]
  },
  "timeline" => {
    "clock_note" => "Controller times use the orb clock; provider times use #{provider_clock}; in-job phase marks use the runner clock. Cross-clock differences carry clock-skew uncertainty.",
    "provider_field_mapping" => provider_field_mapping,
    "controller_call_started_at" => controller["controller_call_started_at"] || "not recorded",
    "controller_trigger_requested_at" => controller["trigger_requested_at"] || "unknown",
    "controller_trigger_first_http_send_at" => controller["trigger_first_http_send_at"] || "not recorded",
    "controller_trigger_accepted_at" => controller["trigger_accepted_at"] || "unknown",
    "provider_run_created_at" => run["created_at"] || "unknown",
    "provider_run_started_at" => run["run_started_at"] || "unknown",
    "provider_job_queued_at" => job["created_at"] || "unknown",
    "provider_job_started_at" => job["started_at"] || "unknown",
    "provider_job_completed_at" => job["completed_at"] || "unknown",
    "provider_run_updated_at" => run["updated_at"] || "unknown",
    "collector_observed_at" => observed_at,
    "provider_queue_ms" => ms_between(job["created_at"], job["started_at"]),
    "provider_job_ms" => ms_between(job["started_at"], job["completed_at"]),
    "provider_run_ms" => ms_between(run["run_started_at"], job["completed_at"]),
    "controller_accept_to_job_completed_ms" => ms_between(controller["trigger_accepted_at"], job["completed_at"]),
    "controller_accept_to_job_completed_note" => "Orb-clock acceptance to #{build ? "Buildkite-clock workload job finished_at" : "GitHub-clock job completed_at"}; excludes request-to-acceptance and is not a provider terminal-result boundary. Not a complete trigger-to-result interval.",
    "controller_last_nonterminal_response_at" => observation["last_nonterminal_response_at"] || "not recorded",
    "controller_terminal_observed_at" => observation["observed_at"] || "not recorded",
    "controller_poll_interval_ms" => observation["poll_interval_ms"] || "not recorded",
    "controller_poll_limiter" => observation["poll_limiter"] || "not recorded",
    "provider_terminal_boundary" => provider_terminal_boundary,
    "controller_request_to_accept_ms" => ms_between(controller["trigger_requested_at"], controller["trigger_accepted_at"]),
    "controller_limiter_wait_before_send_ms" => controller["trigger_first_http_send_at"] ? ms_between(controller["trigger_requested_at"], controller["trigger_first_http_send_at"]) : "not recorded",
    "controller_send_to_accept_ms" => controller["trigger_first_http_send_at"] ? ms_between(controller["trigger_first_http_send_at"], controller["trigger_accepted_at"]) : "not recorded",
    "controller_request_to_terminal_observed_ms" => ms_between(controller["trigger_requested_at"], observation["observed_at"]),
    "controller_accept_to_terminal_observed_ms" => ms_between(controller["trigger_accepted_at"], observation["observed_at"]),
    "provider_run_created_to_terminal_ms" => run["status"] == "completed" ? ms_between(run["created_at"], run["updated_at"]) : "unknown",
    "interval_clock_classes" => {
      "same_clock_orb" => %w[controller_request_to_accept_ms controller_limiter_wait_before_send_ms controller_send_to_accept_ms controller_request_to_terminal_observed_ms controller_accept_to_terminal_observed_ms],
      "same_clock_provider" => %w[provider_queue_ms provider_job_ms provider_run_ms provider_run_created_to_terminal_ms],
      "cross_clock_estimate" => %w[controller_accept_to_job_completed_ms],
      "note" => "Terminal observation intervals trail the provider terminal state by up to one poll interval plus, per poll, shared client rate-limiter wait (controller_poll_limiter), retry backoff, and API latency; not recorded for samples collected after completion. controller_request_to_accept_ms includes the client limiter wait before the first send (controller_limiter_wait_before_send_ms) when recorded; controller_send_to_accept_ms excludes it."
    }
  },
  "phases" => phases,
  "provider_steps" => steps,
  "runner" => runner,
  "cache" => probe ? { "benchmark_cache" => "not used by the probe" } : cache.merge(
    "provider_owned_unknowns" => [
      "runner image tool cache contents",
      "Docker base-image layers present on the host image",
      "package mirror and network caches",
      "Playwright download CDN and apt mirror caches"
    ],
    "qualification" => "benchmark-cold only: explicit dependency cache keyed by cache_epoch; provider-owned caches cannot be flushed"
  ),
  "result" => result && {
    "status" => result["status"],
    "error" => result["error"],
    "target" => result["target"],
    "profile" => result["profile"],
    "duration_ms" => result.dig("timeline", "duration_ms"),
    "verification_digest" => result.dig("verification", "digest"),
    "expected_verification_digest" => expected_digest,
    "workloads" => result["workloads"].map { |w| w.slice("name", "status", "duration_ms") }
  },
  "evidence" => {
    "artifact_checksums" => checksums,
    "retained_in" => "GitHub Actions artifact plus controller-local tmp/pilot-evidence"
  },
  "comparative_sample_valid" => issues.empty?,
  "invalid_reasons" => issues
}

puts JSON.pretty_generate(record)
