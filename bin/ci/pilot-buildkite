#!/usr/bin/env bash
# Controller for the unscored Buildkite GHAC pilot.
#
#   bin/ci/pilot-buildkite run probe.yml EXPECTED_SHA
#   bin/ci/pilot-buildkite run pilot.yml EXPECTED_SHA PROFILE CACHE_PHASE CACHE_EPOCH
#   bin/ci/pilot-buildkite run native-probe.yml EXPECTED_SHA
#   bin/ci/pilot-buildkite run native-pilot.yml EXPECTED_SHA PROFILE CACHE_PHASE CACHE_EPOCH
#   bin/ci/pilot-buildkite collect BUILD_NUMBER [EVIDENCE_DIR]
#
# run records the cluster cache volumes, creates a build through the REST API
# with CI_BENCH_* build env (read by bin/ci/pilot-bk-import), records the
# controller request/acceptance times, polls every 2 s to the controller's
# first terminal observation, records the volumes again, and collects.
# BUILDKITE_API_TOKEN comes from a private Amp secret and is passed to curl on
# stdin, never on the command line. Evidence stays under tmp/pilot-evidence.
set -euo pipefail

cd "$(dirname "$0")/../.."
org="${CI_BENCH_BUILDKITE_ORG:-greenbardev}"
pipeline="${CI_BENCH_BUILDKITE_PIPELINE:-ci-bench}"
cluster="${CI_BENCH_BUILDKITE_CLUSTER:-ab509202-9130-4b55-975d-329bf3a74c64}"
repo="${CI_BENCH_REPO:-greenbar-research/ci-bench}"
api="https://api.buildkite.com/v2/organizations/$org"
iso_now() { date -u +%Y-%m-%dT%H:%M:%S.%3NZ; }

# throttle NAME MIN_MS: spaces every HTTP attempt to one API, including
# retries, across all controllers on this host (lock and timestamp under
# TMPDIR), bounding the aggregate rate. When CI_BENCH_LIMITER_LOG is set, each
# call appends the milliseconds it waited, so records can separate client-side
# delay from provider time.
throttle() {
  local file="${TMPDIR:-/tmp}/ci-bench-$1.rate" min_ms="$2" fd last now waited=0
  exec {fd}>>"$file.lock"
  flock "$fd"
  last="$(cat "$file" 2>/dev/null || echo 0)"
  now="$(date +%s%3N)"
  if (( now - last < min_ms )); then
    waited=$((min_ms - now + last))
    sleep "$(awk -v ms="$waited" 'BEGIN { print ms / 1000 }')"
  fi
  date +%s%3N > "$file"
  exec {fd}>&-
  if [[ -n "${CI_BENCH_LIMITER_LOG:-}" ]]; then echo "$waited" >> "$CI_BENCH_LIMITER_LOG"; fi
}

# limiter_summary FILE: total wait and attempt count logged by throttle.
limiter_summary() {
  awk '{ total += $1; n++ } END { printf "{\"wait_ms\": %d, \"attempts\": %d}", total, n }' "$1" 2>/dev/null || echo '{"wait_ms": 0, "attempts": 0}'
}

# GitHub allows 5,000 REST requests per hour; 800 ms spacing keeps all
# controllers together under 4,500.
ghapi() { throttle github 800; gh api "$@"; }

# Revision of the controller code that started this run, captured once at
# controller start before any request. A running Bash controller keeps the
# definitions it started with, so this can differ from both the measured SHA
# and a later collector.
controller_revision() {
  jq -n --arg sha "$(git rev-parse HEAD)" --argjson dirty "$([[ -z "$(git status --porcelain -- bin/ci)" ]] && echo false || echo true)" \
    '{sha: $sha, bin_ci_dirty: $dirty}'
}

# verify_pilot_tag SHA: the measured commit is dispatched through the
# immutable lightweight tag pilot/SHA, so later collector-only pushes to main
# never change what a run or a cold/warm pair measures.
verify_pilot_tag() {
  local sha="$1" object
  object="$(ghapi "repos/$repo/git/ref/tags/pilot/$sha" --jq '"\(.object.type) \(.object.sha)"' 2>/dev/null || true)"
  if [[ "$object" != "commit $sha" ]]; then
    echo "tag pilot/$sha does not name commit $sha; refusing" >&2
    exit 1
  fi
}

# bk URL [OUTPUT_FILE]: authenticated read-only GET to OUTPUT_FILE or stdout;
# the header is read from stdin. Buildkite allows 50 REST requests per user
# per minute. Every attempt, including retries of 429, 5xx, and connection
# failures, passes through the shared 1.3 s limiter, and retries wait for
# Retry-After (10 s by default). Only idempotent reads go through bk; builds
# are created with bk_create.
bk() {
  local url="$1" output="${2:-}" out headers code="" wait attempt
  : "${BUILDKITE_API_TOKEN:?BUILDKITE_API_TOKEN is not loaded}"
  out="$(mktemp)" headers="$(mktemp)"
  for attempt in 1 2 3 4 5 6 7 8; do
    throttle buildkite 1300
    code="$(curl --silent --show-error --location --output "$out" --dump-header "$headers" --write-out '%{http_code}' -K - "$url" \
      <<<"header = \"Authorization: Bearer $BUILDKITE_API_TOKEN\"" || true)"
    if [[ "$code" == 2?? ]]; then
      if [[ -n "$output" ]]; then mv "$out" "$output"; else cat "$out"; rm -f "$out"; fi
      rm -f "$headers"
      return 0
    fi
    [[ "$code" == 429 || "$code" == 5?? || "$code" == 000 || -z "$code" ]] || break
    wait="$(awk -F': *' 'tolower($1) == "retry-after" { v = $2 + 0 } END { print v + 0 }' "$headers")"
    sleep "$(( wait > 0 ? wait : 10 ))"
  done
  rm -f "$out" "$headers"
  echo "GET ${url%%\?*} failed with HTTP ${code:-none}" >&2
  return 1
}

# bk_create BODY_FILE SHA REQUEST_ID STATE_DIR: creates one build and prints it.
# It writes STATE_DIR/first_send_at after the first limiter wait, and
# STATE_DIR/reconciled when the build was found by lookup. Only a
# 429, a definite rejection, is retried after Retry-After. Any other failure
# may follow acceptance, so the build is looked up by its CI_BENCH_REQUEST_ID
# env instead of posting again.
bk_create() {
  local body="$1" sha="$2" request_id="$3" state="$4" out headers code="" wait attempt
  out="$(mktemp)" headers="$(mktemp)"
  for attempt in 1 2 3 4 5; do
    throttle buildkite 1300
    if [[ "$attempt" == 1 ]]; then iso_now > "$state/first_send_at"; fi
    code="$(curl --silent --show-error --output "$out" --dump-header "$headers" --write-out '%{http_code}' -K - \
      -X POST -H 'Content-Type: application/json' --data-binary "@$body" "$api/pipelines/$pipeline/builds" \
      <<<"header = \"Authorization: Bearer $BUILDKITE_API_TOKEN\"" || true)"
    if [[ "$code" == 201 ]]; then
      cat "$out"
      rm -f "$out" "$headers"
      return 0
    fi
    [[ "$code" == 429 ]] || break
    wait="$(awk -F': *' 'tolower($1) == "retry-after" { print $2 + 0 }' "$headers")"
    sleep "${wait:-30}"
  done
  rm -f "$out" "$headers"
  echo "build create returned HTTP ${code:-none}; reconciling by request ID $request_id" >&2
  sleep 10
  local builds match
  if ! builds="$(bk "$api/pipelines/$pipeline/builds?commit=$sha&per_page=30")"; then
    echo "lookup failed, so whether request ID $request_id was accepted is unknown; not posting again" >&2
    return 1
  fi
  match="$(jq -c --arg id "$request_id" '[.[] | select(.env.CI_BENCH_REQUEST_ID == $id)] | if length == 1 then .[0] else empty end' <<<"$builds")"
  if [[ -z "$match" ]]; then
    echo "no single build carries request ID $request_id; not posting again" >&2
    return 1
  fi
  echo "$code" > "$state/reconciled"
  printf '%s\n' "$match"
}

sanitize() {
  sed -E \
    -e 's/(bkua_|bkat_)[A-Za-z0-9]{20,}/\1[REDACTED]/g' \
    -e 's/(gh[pousr]_)[A-Za-z0-9]{20,}/\1[REDACTED]/g' \
    -e 's/(github_pat_)[A-Za-z0-9_]{20,}/\1[REDACTED]/g' \
    -e 's/(AUTHORIZATION: (basic|bearer|token) )[^ ]+/\1[REDACTED]/Ig'
}

volumes() { bk "$api/clusters/$cluster/cache_volumes"; }

run() {
  local workflow="$1" sha="$2" profile="${3:-probe}" phase="${4:-}" epoch="${5:-}"
  local call_started_at revision
  call_started_at="$(iso_now)"
  revision="$(controller_revision)"
  verify_pilot_tag "$sha"
  local target=buildkite-ghac runner=ubuntu-24.04
  case "$workflow" in
    probe.yml|native-probe.yml) [[ "$profile" == probe ]] || { echo "probes take no profile" >&2; exit 2; } ;;
    pilot.yml|native-pilot.yml) [[ -n "$phase" && -n "$epoch" ]] || { echo "pilot workloads need PROFILE CACHE_PHASE CACHE_EPOCH" >&2; exit 2; } ;;
    *) echo "workflow must be probe.yml, pilot.yml, native-probe.yml, or native-pilot.yml" >&2; exit 2 ;;
  esac
  [[ "$workflow" == native-* ]] && target=buildkite-native runner=buildkite-native
  local scratch volumes_before body requested_at response accepted_at number dir request_id
  request_id="$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
  scratch="$(mktemp -d)"
  volumes_before="$(volumes)"
  body="$scratch/body.json"
  jq -n --arg sha "$sha" --arg workflow "$workflow" --arg profile "$profile" --arg phase "$phase" --arg epoch "$epoch" --arg request_id "$request_id" \
    '{commit: $sha, branch: "main", message: "ci-bench unscored pilot \($workflow) \($profile) \($phase)",
      env: ({CI_BENCH_WORKFLOW: $workflow, CI_BENCH_EXPECTED_SHA: $sha, CI_BENCH_REQUEST_ID: $request_id}
        + (if ($workflow | test("pilot")) then {CI_BENCH_PROFILE: $profile, CI_BENCH_CACHE_PHASE: $phase, CI_BENCH_CACHE_EPOCH: $epoch} else {} end))}' > "$body"
  # requested_at precedes the limiter wait; first_send_at follows it.
  requested_at="$(iso_now)"
  response="$(bk_create "$body" "$sha" "$request_id" "$scratch")"
  accepted_at="$(iso_now)"
  local acceptance="create response"
  [[ -f "$scratch/reconciled" ]] && acceptance="reconciled by request ID after HTTP $(cat "$scratch/reconciled"); trigger_accepted_at is the lookup time"
  number="$(jq -r .number <<<"$response")"
  dir="tmp/pilot-evidence/bk-$number"
  mkdir -p "$dir"
  jq -n --arg call_started_at "$call_started_at" --arg first_send_at "$(cat "$scratch/first_send_at")" \
    --arg requested_at "$requested_at" --arg accepted_at "$accepted_at" --arg workflow "$workflow" --arg target "$target" --arg runner "$runner" \
    --arg profile "$profile" --arg phase "$phase" --arg epoch "$epoch" --arg sha "$sha" \
    --argjson response "$response" --argjson volumes "$volumes_before" \
    --arg request_id "$request_id" --arg acceptance "$acceptance" --argjson controller_revision "$revision" \
    '{controller_clock: "orb UTC", controller_revision: $controller_revision, request_id: $request_id, trigger_acceptance: $acceptance,
      poll_interval_ms: 5000, target: $target, workflow: $workflow, profile: $profile,
      controller_call_started_at: $call_started_at, trigger_requested_at: $requested_at,
      trigger_first_http_send_at: $first_send_at, trigger_accepted_at: $accepted_at,
      inputs: ({expected_sha: $sha, runner: $runner} + (if ($workflow | test("pilot")) then {profile: $profile, cache_phase: $phase, cache_epoch: $epoch} else {} end)),
      provider_cache_volumes_before: $volumes,
      dispatch_response: ($response | {id, number, web_url, state, commit, branch, created_at})}' > "$dir/controller.json"
  jq -r '"\(.number) \(.web_url)"' <<<"$response"

  local state last_pending_at observed_at polls=0
  last_pending_at="$accepted_at"
  export CI_BENCH_LIMITER_LOG="$scratch/poll-limiter.log"
  while :; do
    polls=$((polls + 1))
    state="$(bk "$api/pipelines/$pipeline/builds/$number" | jq -r 'if .finished_at then "terminal" else .state end' || echo poll-error)"
    if [[ "$state" == terminal ]]; then
      observed_at="$(iso_now)"
      break
    fi
    last_pending_at="$(iso_now)"
    sleep 5
  done
  unset CI_BENCH_LIMITER_LOG
  jq --arg observed_at "$observed_at" --arg last_pending_at "$last_pending_at" --argjson polls "$polls" \
    --argjson limiter "$(limiter_summary "$scratch/poll-limiter.log")" --argjson volumes "$(volumes)" \
    '.terminal_observation = {observed_at: $observed_at, last_nonterminal_response_at: $last_pending_at,
      poll_interval_ms: 5000, polls: $polls, poll_limiter: $limiter} | .provider_cache_volumes_after = $volumes' \
    "$dir/controller.json" > "$dir/controller.json.new"
  mv "$dir/controller.json.new" "$dir/controller.json"
  rm -rf "$scratch"
  collect "$number" "$dir"
}

collect() {
  local number="$1" dir="${2:-tmp/pilot-evidence/bk-$1}"
  mkdir -p "$dir/logs"
  local observed_at
  observed_at="$(iso_now)"
  bk "$api/pipelines/$pipeline/builds/$number" > "$dir/build.json"
  bk "$api/pipelines/$pipeline/builds/$number/artifacts?per_page=100" > "$dir/artifacts.json"
  jq -r '.jobs[] | select(.raw_log_url) | "\(.id)\t\(.step_key // .id)"' "$dir/build.json" |
    while IFS=$'\t' read -r job_id key; do
      bk "$api/pipelines/$pipeline/builds/$number/jobs/$job_id/log" | jq -r '.content // ""' | sanitize > "$dir/logs/$key.txt" || true
    done
  # GHAC workload jobs upload one actions/upload-artifact ZIP; native steps
  # upload tmp/pilot/** directly.
  local workload_job download
  workload_job="$(jq -r '[.jobs[] | select((.step_key // "") | (test("^gha-") and (test("^gha-(importer|concurrency-)") | not)) or test("^native-"))][0].id // empty' "$dir/build.json")"
  rm -rf "$dir/artifact"
  mkdir -p "$dir/artifact"
  download="$(jq -r --arg job "$workload_job" '[.[] | select(.job_id == $job and (.path | test("^buildkite-gha/v1/artifacts/.*\\.zip$")))] | if length == 1 then .[0].download_url else empty end' "$dir/artifacts.json")"
  if [[ -n "$download" ]]; then
    bk "$download" "$dir/artifact.zip"
    unzip -q -o "$dir/artifact.zip" -d "$dir/artifact"
    rm -f "$dir/artifact.zip"
  else
    jq -r --arg job "$workload_job" '.[] | select(.job_id == $job and (.path | startswith("tmp/pilot/"))) | "\(.download_url)\t\(.path)"' "$dir/artifacts.json" |
      while IFS=$'\t' read -r url path; do
        mkdir -p "$dir/artifact/$(dirname "${path#tmp/pilot/}")"
        bk "$url" "$dir/artifact/${path#tmp/pilot/}"
      done
  fi
  if [[ -f "$dir/artifact/SHA256SUMS" ]]; then
    (cd "$dir/artifact" && sha256sum --check --quiet SHA256SUMS) \
      && echo verified > "$dir/artifact-checksums.txt" \
      || echo failed > "$dir/artifact-checksums.txt"
  else
    echo unavailable > "$dir/artifact-checksums.txt"
  fi
  ruby bin/ci/pilot-provenance "$dir" "$observed_at" > "$dir/provenance.json"
  jq '{target, provider: .provider, comparative_sample_valid, invalid_reasons, cold_qualification}' "$dir/provenance.json"
}

case "${1:-}" in
  run) shift; run "$@" ;;
  collect) shift; collect "$@" ;;
  volumes) volumes | jq . ;;
  *) sed -n '2,13p' "$0" >&2; exit 2 ;;
esac
