<main>
  <h1>CI projects</h1>

  <%= form_with model: Project.new do |form| %>
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>
    <%= form.submit "Create project" %>
  <% end %>

  <ul aria-label="Projects">
    <% @projects.each do |project| %>
      <li><%= project.name %></li>
    <% end %>
  </ul>
</main>
